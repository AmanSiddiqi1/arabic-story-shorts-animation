{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان سعيد بن سالم يعيش في زمن الخليفة هارون الرشيد،",
   "en": "Said ibn Salim lived in Harun al-Rashid’s time",
   "a": 0,
   "b": 5.606
  },
  {
   "p": 0,
   "c": 1,
   "ar": "وقد تراكمت عليه ديون كثيرة.",
   "en": "and had fallen deep into debt.",
   "a": 6.047,
   "b": 9.16
  },
  {
   "p": 0,
   "c": 2,
   "ar": "صار الدائنون يأتون إلى بابه كل يوم، ويطالبونه بأموالهم،",
   "en": "Creditors crowded his door daily,",
   "a": 9.743,
   "b": 16.582
  },
  {
   "p": 0,
   "c": 3,
   "ar": "حتى ضاقت به السبل ولم يعرف من أين يبدأ.",
   "en": "leaving him desperate.",
   "a": 16.814,
   "b": 21.34
  },
  {
   "p": 1,
   "c": 0,
   "ar": "ذهب إلى رجل يعرفه اسمه عبد الله بن مالك،",
   "en": "He sought advice from Abdullah ibn Malik,",
   "a": 21.901,
   "b": 27.2
  },
  {
   "p": 1,
   "c": 1,
   "ar": "وسأله عن طريقة للخروج من محنته.",
   "en": "who said only the powerful Barmakid family",
   "a": 27.691,
   "b": 31.38
  },
  {
   "p": 1,
   "c": 2,
   "ar": "قال عبد الله إن أحدًا لا يستطيع أن يساعده مثل أسرة البرامكة،",
   "en": "could rescue him",
   "a": 31.868,
   "b": 38.874
  },
  {
   "p": 1,
   "c": 3,
   "ar": "وإن عليه أن يطلب عونها.",
   "en": "from his debts.",
   "a": 39.3,
   "b": 41.7
  },
  {
   "p": 2,
   "c": 0,
   "ar": "تردد سعيد،",
   "en": "Said hesitated,",
   "a": 42.252,
   "b": 43.7
  },
  {
   "p": 2,
   "c": 1,
   "ar": "وقال إنه يخشى أن يقابله أبناؤها بكلام متعالٍ ولا يعطوه شيئًا.",
   "en": "afraid the brothers would treat him arrogantly.",
   "a": 44.235,
   "b": 52.02
  },
  {
   "p": 2,
   "c": 2,
   "ar": "أجابه عبد الله بأن عليه أن يحتمل ما يسمعه،",
   "en": "Abdullah advised him to endure any unpleasantness",
   "a": 52.541,
   "b": 57.348
  },
  {
   "p": 2,
   "c": 3,
   "ar": "ما دام يريد إنقاذ بيته من الدائنين المتجمعين حوله.",
   "en": "if it meant escaping his creditors.",
   "a": 57.727,
   "b": 63.14
  },
  {
   "p": 3,
   "c": 0,
   "ar": "زار سعيد الفضل وجعفر، وهما ابنا يحيى بن خالد،",
   "en": "Said visited al-Fadl and Jaafar, Yahya’s sons,",
   "a": 63.791,
   "b": 69.48
  },
  {
   "p": 3,
   "c": 1,
   "ar": "وحكى لهما حاله.",
   "en": "and explained his plight.",
   "a": 69.903,
   "b": 71.749
  },
  {
   "p": 3,
   "c": 2,
   "ar": "سمعا كلامه، ودعوا الله أن يفرج كربه ويرزقه الغنى،",
   "en": "They prayed that God would relieve him,",
   "a": 72.216,
   "b": 78.06
  },
  {
   "p": 3,
   "c": 3,
   "ar": "لكنهما لم يسلماه مالًا وهو جالس أمامهما.",
   "en": "but handed him no money.",
   "a": 78.69,
   "b": 83.96
  },
  {
   "p": 4,
   "c": 0,
   "ar": "خرج سعيد حزينًا، وعاد إلى عبد الله يشكو أن الزيارة لم تنفعه.",
   "en": "Disappointed, Said returned to Abdullah and complained.",
   "a": 84.5,
   "b": 92.02
  },
  {
   "p": 4,
   "c": 1,
   "ar": "دعاه عبد الله إلى الجلوس بقية اليوم، لعل شيئًا يتغير.",
   "en": "Abdullah asked him to stay awhile in case help arrived,",
   "a": 92.602,
   "b": 98.0
  },
  {
   "p": 4,
   "c": 2,
   "ar": "جلس الرجل مهمومًا،",
   "en": "and Said sat",
   "a": 98.765,
   "b": 100.78
  },
  {
   "p": 4,
   "c": 3,
   "ar": "وهو يفكر في الديون التي تنتظره في البيت.",
   "en": "worrying about his debts.",
   "a": 101.421,
   "b": 105.38
  },
  {
   "p": 5,
   "c": 0,
   "ar": "لم يمر وقت طويل حتى جاء خادم سعيد مسرعًا،",
   "en": "Soon Said’s servant arrived breathlessly:",
   "a": 105.921,
   "b": 111.06
  },
  {
   "p": 5,
   "c": 1,
   "ar": "وقال إن عند باب البيت بغالًا كثيرة محملة بالأموال،",
   "en": "loaded mules stood outside their house",
   "a": 111.638,
   "b": 118.04
  },
  {
   "p": 5,
   "c": 2,
   "ar": "ورجلًا يحمل رسالة من الفضل وجعفر.",
   "en": "with a messenger bearing a letter",
   "a": 118.43,
   "b": 122.24
  },
  {
   "p": 5,
   "c": 3,
   "ar": "أسرع سعيد إلى منزله وفتح الرسالة بيد مرتجفة.",
   "en": "from the two brothers.",
   "a": 122.876,
   "b": 128.296
  },
  {
   "p": 6,
   "c": 0,
   "ar": "كتب الأخوان أنهما أخبرا الخليفة بحاله،",
   "en": "The letter explained that the caliph",
   "a": 128.747,
   "b": 133.13
  },
  {
   "p": 6,
   "c": 1,
   "ar": "فأمر له بمليون درهم لسداد الدين،",
   "en": "had granted one million dirhams for debts",
   "a": 133.6,
   "b": 137.535
  },
  {
   "p": 6,
   "c": 2,
   "ar": "ثم أضاف ثلاثمئة ألف لينفق منها بعد السداد.",
   "en": "and three hundred thousand for living expenses.",
   "a": 137.95,
   "b": 143.37
  },
  {
   "p": 6,
   "c": 3,
   "ar": "وأرسل كل واحد من الأخوين مليونًا آخر من ماله الخاص.",
   "en": "Each brother also gave a million personally.",
   "a": 143.8,
   "b": 149.64
  },
  {
   "p": 7,
   "c": 0,
   "ar": "صار مجموع ما وصل إلى سعيد",
   "en": "Said received",
   "a": 150.382,
   "b": 153.2
  },
  {
   "p": 7,
   "c": 1,
   "ar": "ثلاثة ملايين وثلاثمئة ألف درهم.",
   "en": "three million three hundred thousand dirhams altogether.",
   "a": 153.2,
   "b": 157.28
  },
  {
   "p": 7,
   "c": 2,
   "ar": "عندها فهم أن الفضل وجعفر لم يكتفيا بالكلام الطيب،",
   "en": "The brothers had worked quietly after his visit",
   "a": 157.823,
   "b": 163.78
  },
  {
   "p": 7,
   "c": 3,
   "ar": "بل عملا في الخفاء ليكون العون أكبر مما توقع، وليبدأ حياة جديدة.",
   "en": "to secure far more help than he imagined.",
   "a": 164.09,
   "b": 171.62
  }
 ],
