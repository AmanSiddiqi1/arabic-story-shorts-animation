{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "هرب الشاعر المتلمس من الملك النعمان بن المنذر،",
   "en": "The poet al-Mutalammis fled King al-Numan",
   "a": 0,
   "b": 5.06
  },
  {
   "p": 0,
   "c": 1,
   "ar": "وغاب عن أهله زمنًا طويلًا.",
   "en": "and remained away for a long time.",
   "a": 5.549,
   "b": 8.807
  },
  {
   "p": 0,
   "c": 2,
   "ar": "انتظرته زوجته أميمة بقلق، ولم يصلها منه خبر يطمئنها،",
   "en": "His wife Umaymah waited anxiously",
   "a": 9.261,
   "b": 16.46
  },
  {
   "p": 0,
   "c": 3,
   "ar": "حتى شاع بين الناس أنه مات ولن يعود.",
   "en": "until people began to believe he was dead.",
   "a": 16.981,
   "b": 21.54
  },
  {
   "p": 1,
   "c": 0,
   "ar": "كانت أميمة تحب زوجها حبًا كبيرًا،",
   "en": "Umaymah loved him deeply",
   "a": 22.036,
   "b": 26.255
  },
  {
   "p": 1,
   "c": 1,
   "ar": "ولذلك رفضت أن تتزوج غيره.",
   "en": "and refused to remarry.",
   "a": 26.725,
   "b": 30.22
  },
  {
   "p": 1,
   "c": 2,
   "ar": "لكن أهلها قالوا إن عليها أن تبدأ حياة جديدة،",
   "en": "Her relatives urged her to begin anew,",
   "a": 30.683,
   "b": 35.86
  },
  {
   "p": 1,
   "c": 3,
   "ar": "وإن الانتظار لا فائدة منه بعدما انقطعت أخبار الرجل كل تلك السنوات.",
   "en": "arguing that years without news made further waiting hopeless.",
   "a": 36.316,
   "b": 43.5
  },
  {
   "p": 2,
   "c": 0,
   "ar": "كثر الذين طلبوا يدها،",
   "en": "Many suitors came.",
   "a": 44.045,
   "b": 46.36
  },
  {
   "p": 2,
   "c": 1,
   "ar": "واستمر ضغط أهلها عليها حتى وافقت أخيرًا، وهي غير مطمئنة إلى قرارها.",
   "en": "Finally she agreed reluctantly,",
   "a": 47.014,
   "b": 54.94
  },
  {
   "p": 2,
   "c": 2,
   "ar": "حددوا ليلة للزفاف، واجتمع الناس في الحي،",
   "en": "and the family arranged a wedding.",
   "a": 55.479,
   "b": 60.086
  },
  {
   "p": 2,
   "c": 3,
   "ar": "وسمعت أصوات الغناء والدفوف من الخيام.",
   "en": "Songs and drums sounded through the camp on the appointed night.",
   "a": 60.56,
   "b": 64.656
  },
  {
   "p": 3,
   "c": 0,
   "ar": "وفي تلك الليلة نفسها عاد المتلمس من سفره،",
   "en": "On that very night al-Mutalammis returned",
   "a": 65.082,
   "b": 69.909
  },
  {
   "p": 3,
   "c": 1,
   "ar": "ورأى الزينة وسمع الفرح.",
   "en": "and saw the celebration.",
   "a": 70.398,
   "b": 73.32
  },
  {
   "p": 3,
   "c": 2,
   "ar": "سأل صبيانًا عن سبب الاحتفال،",
   "en": "Children told him that Umaymah,",
   "a": 73.891,
   "b": 76.944
  },
  {
   "p": 3,
   "c": 3,
   "ar": "فأخبروه أن أميمة، زوجة المتلمس الذي يظنونه ميتًا، تتزوج رجلًا آخر.",
   "en": "the wife of the man everyone thought dead, was marrying someone else.",
   "a": 77.251,
   "b": 85.766
  },
  {
   "p": 4,
   "c": 0,
   "ar": "دهش الشاعر وتألم، ثم دخل بين الحاضرين دون أن يعرفه أحد.",
   "en": "Shocked and hurt, the poet entered unnoticed among the guests.",
   "a": 86.239,
   "b": 93.66
  },
  {
   "p": 4,
   "c": 1,
   "ar": "رأى أميمة قرب العريس الجديد، وكانت حزينة رغم الاحتفال.",
   "en": "He saw Umaymah grieving beside her new groom,",
   "a": 94.2,
   "b": 100.82
  },
  {
   "p": 4,
   "c": 2,
   "ar": "وعندما اقترب العريس منها، تنهدت وأخذت تردد بيتًا من الشعر.",
   "en": "and she began to recite a sorrowful verse.",
   "a": 101.331,
   "b": 108.28
  },
  {
   "p": 5,
   "c": 0,
   "ar": "تساءلت أميمة في بيتها أين أصبح زوجها الغائب،",
   "en": "Umaymah wondered aloud in verse",
   "a": 108.736,
   "b": 114.0
  },
  {
   "p": 5,
   "c": 1,
   "ar": "وفي أي أرض بعيدة يعيش إن كان حيًا.",
   "en": "where her absent husband might be.",
   "a": 114.465,
   "b": 118.706
  },
  {
   "p": 5,
   "c": 2,
   "ar": "لم يستطع المتلمس أن يصمت، فأجابها ببيت من شعره",
   "en": "Al-Mutalammis answered with his own verse:",
   "a": 119.132,
   "b": 124.88
  },
  {
   "p": 5,
   "c": 3,
   "ar": "يقول إنه قريب، وإنه لم ينس حبها.",
   "en": "he was close at hand and had never forgotten her.",
   "a": 124.88,
   "b": 129.68
  },
  {
   "p": 6,
   "c": 0,
   "ar": "عرفت أميمة صوت زوجها،",
   "en": "Umaymah recognized her husband’s voice.",
   "a": 130.274,
   "b": 132.74
  },
  {
   "p": 6,
   "c": 1,
   "ar": "وفهم العريس الجديد حقيقة ما حدث.",
   "en": "The new groom understood at once",
   "a": 133.348,
   "b": 137.08
  },
  {
   "p": 6,
   "c": 2,
   "ar": "لم يغضب الرجل ولم يخاصمهما، بل أنشد كلمات تدل على أنه سيتنحى،",
   "en": "and, without quarreling, spoke graciously",
   "a": 137.605,
   "b": 145.3
  },
  {
   "p": 6,
   "c": 3,
   "ar": "ثم ترك لهما المكان وانصرف دون أن يعود.",
   "en": "and withdrew, leaving the reunited couple alone.",
   "a": 145.3,
   "b": 150.32
  },
  {
   "p": 7,
   "c": 0,
   "ar": "عاد المتلمس إلى أميمة بعد غياب ظنه الناس نهاية حياته.",
   "en": "After an absence everyone mistook for death,",
   "a": 150.833,
   "b": 157.398
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وبقي الزوجان معًا في راحة وسرور بعد أن زال سوء الفهم،",
   "en": "al-Mutalammis and Umaymah were together again.",
   "a": 157.871,
   "b": 163.82
  },
  {
   "p": 7,
   "c": 2,
   "ar": "وصارت ليلة الزفاف التي بدت حزينة يومًا لعودتهما إلى بعضهما.",
   "en": "The wedding night became the night of their reunion.",
   "a": 164.395,
   "b": 171.34
  }
 ],
