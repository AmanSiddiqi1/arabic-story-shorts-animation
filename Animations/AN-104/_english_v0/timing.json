{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان رجل غريب قد أثقلته الديون،",
   "en": "A stranger burdened by debt",
   "a": 0,
   "b": 3.652
  },
  {
   "p": 0,
   "c": 1,
   "ar": "ولم يجد عملًا ولا طعامًا يكفيه.",
   "en": "had neither work nor enough food.",
   "a": 4.257,
   "b": 7.699
  },
  {
   "p": 0,
   "c": 2,
   "ar": "وبينما يمشي في مدينة كبيرة، رأى جماعة تدخل قصرًا واسعًا،",
   "en": "He followed a group entering a grand mansion,",
   "a": 8.201,
   "b": 15.123
  },
  {
   "p": 0,
   "c": 3,
   "ar": "فتبعها على أمل أن يجد شيئًا يأكله.",
   "en": "hoping he might find something to eat.",
   "a": 15.44,
   "b": 19.362
  },
  {
   "p": 1,
   "c": 0,
   "ar": "دخل مع الزائرين دون أن ينتبه إليه أحد،",
   "en": "He slipped inside unnoticed",
   "a": 20.649,
   "b": 25.306
  },
  {
   "p": 1,
   "c": 1,
   "ar": "ثم جلس في زاوية من الفناء.",
   "en": "and sat in a corner.",
   "a": 26.14,
   "b": 29.212
  },
  {
   "p": 1,
   "c": 2,
   "ar": "رأى أربعة كلاب كبيرة تلبس أطواقًا من ذهب،",
   "en": "Four large dogs wore golden collars",
   "a": 29.604,
   "b": 34.875
  },
  {
   "p": 1,
   "c": 3,
   "ar": "وتربطها سلاسل من فضة، وأمامها أطباق ذهبية.",
   "en": "and silver chains, with solid gold dishes set before them.",
   "a": 35.268,
   "b": 40.829
  },
  {
   "p": 2,
   "c": 0,
   "ar": "وضع الخدم الطعام للكلاب،",
   "en": "Servants brought food for the dogs,",
   "a": 42.094,
   "b": 44.66
  },
  {
   "p": 2,
   "c": 1,
   "ar": "لكن الرجل كان أشد جوعًا منها.",
   "en": "but the man was hungrier than they were.",
   "a": 45.524,
   "b": 49.161
  },
  {
   "p": 2,
   "c": 2,
   "ar": "لاحظه أحد الكلاب، فنظر إليه طويلًا،",
   "en": "One dog watched him,",
   "a": 49.544,
   "b": 54.053
  },
  {
   "p": 2,
   "c": 3,
   "ar": "ثم ابتعد عن طبقه كأنه يدعوه إلى الاقتراب وتناول شيء من الطعام.",
   "en": "then stepped aside as if inviting him to eat.",
   "a": 54.338,
   "b": 61.48
  },
  {
   "p": 3,
   "c": 0,
   "ar": "تردد الرجل أولًا، ثم اقترب وأكل حتى زال جوعه.",
   "en": "He hesitated, then ate until satisfied.",
   "a": 62.794,
   "b": 69.41
  },
  {
   "p": 3,
   "c": 1,
   "ar": "لم يمنعه الكلب،",
   "en": "The dog did not stop him;",
   "a": 69.907,
   "b": 71.4
  },
  {
   "p": 3,
   "c": 2,
   "ar": "بل دفع نحوه الطبق الذهبي بقدمه،",
   "en": "it pushed its golden dish toward him with a paw,",
   "a": 72.071,
   "b": 75.58
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وكأنه يقول له: خذ هذا أيضًا، فلعلك تحتاج إليه أكثر مني.",
   "en": "as though offering that too.",
   "a": 75.839,
   "b": 82.764
  },
  {
   "p": 4,
   "c": 0,
   "ar": "أخذ الرجل الطبق وخرج من القصر، ثم باعه بثمن كبير.",
   "en": "He took the dish, sold it for a great price,",
   "a": 84.099,
   "b": 91.123
  },
  {
   "p": 4,
   "c": 1,
   "ar": "سدد بعض ديونه، واشترى بماله بضاعة يتاجر بها.",
   "en": "paid debts, and invested in trade.",
   "a": 91.593,
   "b": 97.662
  },
  {
   "p": 4,
   "c": 2,
   "ar": "ومع مرور السنوات نجحت تجارته،",
   "en": "Over the years his business prospered,",
   "a": 98.109,
   "b": 101.686
  },
  {
   "p": 4,
   "c": 3,
   "ar": "وأصبح قادرًا على العيش في سعة.",
   "en": "and he became wealthy.",
   "a": 102.092,
   "b": 105.326
  },
  {
   "p": 5,
   "c": 0,
   "ar": "لم ينس الرجل الكلب ولا صاحب القصر.",
   "en": "He never forgot the dog or its owner.",
   "a": 106.5,
   "b": 110.2
  },
  {
   "p": 5,
   "c": 1,
   "ar": "وبعد سنوات عاد يحمل مالًا يعادل قيمة الطبق وهدايا أخرى، يريد رد الجميل.",
   "en": "Years later he returned with repayment and gifts,",
   "a": 111.377,
   "b": 120.04
  },
  {
   "p": 5,
   "c": 2,
   "ar": "لكنه وجد المكان خربًا،",
   "en": "only to find the mansion ruined",
   "a": 121.041,
   "b": 123.6
  },
  {
   "p": 5,
   "c": 3,
   "ar": "وقد اختفى ما كان فيه من غنى.",
   "en": "and its former splendor gone.",
   "a": 124.068,
   "b": 126.875
  },
  {
   "p": 6,
   "c": 0,
   "ar": "سأل عن صاحب القصر،",
   "en": "He found the former owner",
   "a": 128.088,
   "b": 130.2
  },
  {
   "p": 6,
   "c": 1,
   "ar": "فدلوه على رجل فقير يعيش في ضيق. عرف أنه المالك نفسه،",
   "en": "living in poverty.",
   "a": 130.675,
   "b": 137.92
  },
  {
   "p": 6,
   "c": 2,
   "ar": "فأخبره كيف أنقذه طبق الكلب من الجوع والدين،",
   "en": "The visitor explained how the dog’s dish had saved him from hunger and debt,",
   "a": 138.318,
   "b": 143.13
  },
  {
   "p": 6,
   "c": 3,
   "ar": "وقدم إليه المال شاكرًا ومعتذرًا.",
   "en": "then offered the money with thanks.",
   "a": 143.704,
   "b": 147.4
  },
  {
   "p": 7,
   "c": 0,
   "ar": "رفض الرجل الفقير أن يأخذ شيئًا،",
   "en": "The impoverished owner refused:",
   "a": 148.83,
   "b": 152.12
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وقال: لم أعطك الطبق، بل أعطاك إياه كلبي،",
   "en": "His dog had given the dish,",
   "a": 152.845,
   "b": 157.988
  },
  {
   "p": 7,
   "c": 2,
   "ar": "ولا آخذ ثمن هدية قدمها غيري.",
   "en": "and he would not charge for another’s gift.",
   "a": 158.467,
   "b": 162.13
  },
  {
   "p": 7,
   "c": 3,
   "ar": "انصرف الزائر متعجبًا من عزة نفس لم تضعف مع الفقر.",
   "en": "The visitor left amazed by dignity that poverty could not diminish.",
   "a": 162.81,
   "b": 168.39
  }
 ],
