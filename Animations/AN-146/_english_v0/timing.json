{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان رجل قد ترك السرقة وتاب عنها،",
   "en": "A former thief repented",
   "a": 0,
   "b": 5.047
  },
  {
   "p": 0,
   "c": 1,
   "ar": "وفتح دكانًا يبيع فيه الأقمشة في السوق.",
   "en": "and became an honest cloth merchant.",
   "a": 4.997,
   "b": 9.08
  },
  {
   "p": 0,
   "c": 2,
   "ar": "عمل مدة في التجارة، وأصبح يعرف بضائعه جيدًا،",
   "en": "He ran his shop for some time",
   "a": 9.626,
   "b": 15.34
  },
  {
   "p": 0,
   "c": 3,
   "ar": "وكان يغلق المحل عند المساء ويعود إلى بيته مطمئنًا.",
   "en": "and closed it each evening before going home.",
   "a": 15.881,
   "b": 21.4
  },
  {
   "p": 1,
   "c": 0,
   "ar": "في ليلة جاء لص آخر إلى السوق،",
   "en": "One night another thief came",
   "a": 22.806,
   "b": 26.64
  },
  {
   "p": 1,
   "c": 1,
   "ar": "وقد ارتدى ثيابًا تشبه ثياب صاحب الدكان، وحمل مفاتيح معه.",
   "en": "dressed like the merchant, carrying keys.",
   "a": 27.387,
   "b": 34.184
  },
  {
   "p": 1,
   "c": 2,
   "ar": "رأى حارس السوق، وطلب منه أن يشعل له شمعة،",
   "en": "He asked the market watchman to light a candle,",
   "a": 34.736,
   "b": 39.651
  },
  {
   "p": 1,
   "c": 3,
   "ar": "كأنه جاء ليتفقد حساباته.",
   "en": "pretending to check his accounts.",
   "a": 40.093,
   "b": 43.18
  },
  {
   "p": 2,
   "c": 0,
   "ar": "بينما ابتعد الحارس لإحضار النار،",
   "en": "While the watchman went to get a flame,",
   "a": 44.431,
   "b": 47.86
  },
  {
   "p": 2,
   "c": 1,
   "ar": "فتح المحتال الدكان ودخل إليه وأشعل شمعة أخرى.",
   "en": "the impostor opened the shop.",
   "a": 48.894,
   "b": 54.834
  },
  {
   "p": 2,
   "c": 2,
   "ar": "وعندما عاد الحارس وجده جالسًا بين دفاتر الحساب،",
   "en": "The guard returned to find him bent over account books,",
   "a": 55.424,
   "b": 60.8
  },
  {
   "p": 2,
   "c": 3,
   "ar": "يعد الأرقام بأصابعه، فلم يشك في أمره.",
   "en": "apparently calculating figures.",
   "a": 61.445,
   "b": 65.931
  },
  {
   "p": 3,
   "c": 0,
   "ar": "بقي المحتال في الدكان حتى الفجر،",
   "en": "At dawn",
   "a": 67.231,
   "b": 70.7
  },
  {
   "p": 3,
   "c": 1,
   "ar": "ثم طلب من الحارس أن يحضر رجلًا مع جمل لنقل بعض الأقمشة.",
   "en": "the impostor asked for a camel-driver.",
   "a": 71.384,
   "b": 77.672
  },
  {
   "p": 3,
   "c": 2,
   "ar": "حمل الرجل أربع رزم كبيرة،",
   "en": "He loaded four large cloth bales,",
   "a": 78.18,
   "b": 81.2
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وانصرف بها مع اللص، الذي أعطى الحارس درهمين.",
   "en": "departed with them, and tipped the watchman two dirhams.",
   "a": 81.826,
   "b": 86.463
  },
  {
   "p": 4,
   "c": 0,
   "ar": "وصل التاجر الحقيقي صباحًا،",
   "en": "The real merchant arrived",
   "a": 87.727,
   "b": 90.66
  },
  {
   "p": 4,
   "c": 1,
   "ar": "فاستقبله الحارس بترحيب زائد بسبب الدرهمين اللذين ظن أنهما منه.",
   "en": "to unusual friendliness from the guard, who thought he had been tipped.",
   "a": 91.377,
   "b": 98.663
  },
  {
   "p": 4,
   "c": 2,
   "ar": "تعجب صاحب الدكان، ثم فتح الباب،",
   "en": "Inside, the merchant noticed",
   "a": 99.084,
   "b": 103.099
  },
  {
   "p": 4,
   "c": 3,
   "ar": "فرأى آثار الشموع والدفاتر على الأرض، واكتشف اختفاء الرزم الأربع.",
   "en": "candle wax and missing bales.",
   "a": 103.375,
   "b": 110.32
  },
  {
   "p": 5,
   "c": 0,
   "ar": "سأل التاجر الحارس عما حدث، فعرف خبر الرجل والجمل.",
   "en": "He questioned the watchman,",
   "a": 111.65,
   "b": 117.913
  },
  {
   "p": 5,
   "c": 1,
   "ar": "طلب إحضار سائق الجمل، وسأله أين نقل الرزم.",
   "en": "found the camel-driver and learned where the goods had gone.",
   "a": 118.32,
   "b": 123.78
  },
  {
   "p": 5,
   "c": 2,
   "ar": "قاده السائق إلى مخزن قريب من الميناء، حيث وضع البضائع قبل شحنها.",
   "en": "The driver led him to a storeroom near the port.",
   "a": 124.191,
   "b": 131.54
  },
  {
   "p": 6,
   "c": 0,
   "ar": "دخل التاجر المخزن، فوجد الرزم الأربع مربوطة كما تركها،",
   "en": "The merchant found his four bales still bound as before,",
   "a": 132.909,
   "b": 139.98
  },
  {
   "p": 6,
   "c": 1,
   "ar": "وقد وضع اللص عباءته فوقها.",
   "en": "with the thief’s cloak thrown over them.",
   "a": 140.516,
   "b": 143.56
  },
  {
   "p": 6,
   "c": 2,
   "ar": "أخذ التاجر الأقمشة والعباءة،",
   "en": "He recovered the goods",
   "a": 144.462,
   "b": 147.2
  },
  {
   "p": 6,
   "c": 3,
   "ar": "وأعاد تحميل البضائع، ثم مضى مع سائق الجمل نحو السفينة.",
   "en": "and took the cloak as well.",
   "a": 147.653,
   "b": 153.914
  },
  {
   "p": 7,
   "c": 0,
   "ar": "لحق اللص بالتاجر بعدما رأى أن حيلته فشلت،",
   "en": "The thief followed,",
   "a": 155.311,
   "b": 160.46
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وقال له إنه استعاد أقمشته كاملة،",
   "en": "admitting that the merchant had recovered his goods",
   "a": 161.322,
   "b": 165.4
  },
  {
   "p": 7,
   "c": 2,
   "ar": "وطلب أن يعيد له عباءته.",
   "en": "and asking for his cloak back.",
   "a": 165.833,
   "b": 168.52
  },
  {
   "p": 7,
   "c": 3,
   "ar": "ضحك التاجر وأرجع العباءة دون مشاجرة، ثم انصرف كل واحد منهما في طريقه.",
   "en": "The merchant laughed, returned it, and they parted.",
   "a": 169.113,
   "b": 177.38
  }
 ],
