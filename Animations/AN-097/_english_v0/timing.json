{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "أمر الخليفة هارون الرشيد أحد حراسه، واسمه صالح،",
   "en": "Caliph Harun ordered his guard Salih",
   "a": 0,
   "b": 5.76
  },
  {
   "p": 0,
   "c": 1,
   "ar": "أن يأخذ من رجل يدعى منصور مليون درهم قبل غروب الشمس.",
   "en": "to collect a million dirhams from Mansur before sunset,",
   "a": 6.117,
   "b": 12.3
  },
  {
   "p": 0,
   "c": 2,
   "ar": "وقال إن لم يدفع المال في الوقت المحدد، فسيعاقب عقابًا شديدًا.",
   "en": "threatening severe punishment if the money did not arrive.",
   "a": 12.808,
   "b": 19.834
  },
  {
   "p": 1,
   "c": 0,
   "ar": "لم يكن لدى منصور إلا جزء صغير من المبلغ،",
   "en": "Mansur possessed only a small part of the sum.",
   "a": 21.083,
   "b": 25.82
  },
  {
   "p": 1,
   "c": 1,
   "ar": "فاشتد خوفه وعجز عن التفكير.",
   "en": "Seeing his distress,",
   "a": 26.344,
   "b": 29.86
  },
  {
   "p": 1,
   "c": 2,
   "ar": "رق له صالح، واصطحبه إلى بيت يحيى بن خالد البرمكي،",
   "en": "Salih took him to Yahya ibn Khalid al-Barmaki,",
   "a": 30.475,
   "b": 36.3
  },
  {
   "p": 1,
   "c": 3,
   "ar": "الذي اشتهر بكرمه ومساعدة المحتاجين.",
   "en": "a man renowned for generosity.",
   "a": 36.881,
   "b": 40.86
  },
  {
   "p": 2,
   "c": 0,
   "ar": "سمع يحيى القصة،",
   "en": "Yahya heard the story",
   "a": 42.163,
   "b": 43.96
  },
  {
   "p": 2,
   "c": 1,
   "ar": "وطلب من خازنه أن يحضر ما عنده من نقود.",
   "en": "and checked his treasury,",
   "a": 44.884,
   "b": 49.3
  },
  {
   "p": 2,
   "c": 2,
   "ar": "لم يجد في الخزانة إلا خمسة آلاف درهم،",
   "en": "finding only five thousand dirhams.",
   "a": 49.928,
   "b": 54.2
  },
  {
   "p": 2,
   "c": 3,
   "ar": "فبعث يطلب العون من ابنيه الفضل وجعفر دون تأخير.",
   "en": "He immediately asked his sons al-Fadl and Jaafar for help.",
   "a": 54.627,
   "b": 60.38
  },
  {
   "p": 3,
   "c": 0,
   "ar": "أرسل كل واحد من الابنين مبلغًا كبيرًا،",
   "en": "Each son sent a large sum,",
   "a": 61.737,
   "b": 65.96
  },
  {
   "p": 3,
   "c": 1,
   "ar": "فصار لدى يحيى ما يكفي لسداد الدين وزيادة.",
   "en": "enough to cover the debt and more.",
   "a": 66.85,
   "b": 71.32
  },
  {
   "p": 3,
   "c": 2,
   "ar": "وأضاف إلى المال جوهرة نفيسة كان لها تاريخ معروف في مجلس الخليفة،",
   "en": "Yahya added a valuable jewel familiar at the caliph’s court",
   "a": 72.188,
   "b": 79.56
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وسلم الجميع إلى منصور.",
   "en": "and handed everything to Mansur.",
   "a": 80.149,
   "b": 82.64
  },
  {
   "p": 4,
   "c": 0,
   "ar": "شكر منصور يحيى،",
   "en": "Mansur thanked Yahya",
   "a": 83.989,
   "b": 85.976
  },
  {
   "p": 4,
   "c": 1,
   "ar": "ثم خرج مع صالح يحمل المال والجوهرة.",
   "en": "and departed with Salih.",
   "a": 86.857,
   "b": 91.138
  },
  {
   "p": 4,
   "c": 2,
   "ar": "وكان يحيى يأمل أن يتعرف الخليفة إلى الجوهرة،",
   "en": "Yahya hoped the caliph would recognize the jewel,",
   "a": 91.62,
   "b": 96.276
  },
  {
   "p": 4,
   "c": 3,
   "ar": "فيدرك مقدار المساعدة التي قدمها، فيلين قلبه تجاه الرجل المديون.",
   "en": "understand his generosity, and show mercy to the debtor.",
   "a": 96.571,
   "b": 104.0
  },
  {
   "p": 5,
   "c": 0,
   "ar": "لكن منصور، وقد غلبه الخوف،",
   "en": "Yet on the way",
   "a": 104.0,
   "b": 110.02
  },
  {
   "p": 5,
   "c": 1,
   "ar": "أنشد في الطريق أبياتًا أوحت بأنه لم يلجأ إلى المحسن إلا مضطرًا.",
   "en": "Mansur recited verses suggesting he had sought help only from fear.",
   "a": 110.02,
   "b": 117.12
  },
  {
   "p": 5,
   "c": 2,
   "ar": "استنكر صالح كلامه،",
   "en": "Salih rebuked him",
   "a": 117.965,
   "b": 120.082
  },
  {
   "p": 5,
   "c": 3,
   "ar": "وقال إن هذا جزاء سيئ لمن أنقذه من الهلاك.",
   "en": "for such ingratitude toward the man who had saved him.",
   "a": 120.43,
   "b": 126.22
  },
  {
   "p": 6,
   "c": 0,
   "ar": "رفع صالح إلى الخليفة المال والجوهرة، وأخبره كذلك بما قاله منصور.",
   "en": "Salih presented the money and jewel and reported Mansur’s words.",
   "a": 127.523,
   "b": 135.403
  },
  {
   "p": 6,
   "c": 1,
   "ar": "عرف هارون الجوهرة،",
   "en": "Harun recognized the jewel,",
   "a": 135.894,
   "b": 137.953
  },
  {
   "p": 6,
   "c": 2,
   "ar": "وتأثر بكرم يحيى،",
   "en": "was moved by Yahya’s kindness,",
   "a": 138.384,
   "b": 140.78
  },
  {
   "p": 6,
   "c": 3,
   "ar": "فأعادها إليه. وبلغ يحيى أيضًا خبر كلام الرجل بعد أن ساعده.",
   "en": "and returned it to him.",
   "a": 140.78,
   "b": 147.86
  },
  {
   "p": 7,
   "c": 0,
   "ar": "لم يغضب يحيى من منصور،",
   "en": "Yahya did not resent Mansur.",
   "a": 149.222,
   "b": 151.58
  },
  {
   "p": 7,
   "c": 1,
   "ar": "بل قال إن الخوف والحزن قد يجعلان الإنسان يقول ما لا يريد.",
   "en": "He said fear and sorrow can make a person speak badly.",
   "a": 152.443,
   "b": 158.974
  },
  {
   "p": 7,
   "c": 2,
   "ar": "وهكذا انتهت المحنة،",
   "en": "The crisis ended,",
   "a": 159.427,
   "b": 161.984
  },
  {
   "p": 7,
   "c": 3,
   "ar": "وبقي موقف يحيى شاهدًا على كرم لا ينتظر الشكر.",
   "en": "and his generosity stood without any demand for gratitude.",
   "a": 162.466,
   "b": 168.0
  }
 ],
