{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان رجل غني قد خسر ماله كله،",
   "en": "A once-rich man lost his fortune",
   "a": 0,
   "b": 4.118
  },
  {
   "p": 0,
   "c": 1,
   "ar": "وأصبح عاجزًا عن تدبير شؤون بيته.",
   "en": "and could no longer support his household.",
   "a": 5.02,
   "b": 8.49
  },
  {
   "p": 0,
   "c": 2,
   "ar": "نصحته زوجته أن يستعين بصديق قديم يعرفه ويثق به،",
   "en": "His wife urged him to ask",
   "a": 9.065,
   "b": 15.84
  },
  {
   "p": 0,
   "c": 3,
   "ar": "فذهب إليه وأخبره بما أصابه من فقر وضيق.",
   "en": "an old trusted friend for help.",
   "a": 15.84,
   "b": 21.02
  },
  {
   "p": 1,
   "c": 0,
   "ar": "استمع الصديق إليه، وأعطاه خمسمئة دينار ليبدأ عملًا جديدًا.",
   "en": "The friend gave him five hundred dinars.",
   "a": 22.328,
   "b": 29.42
  },
  {
   "p": 1,
   "c": 1,
   "ar": "وكان الرجل قد عمل صائغًا في شبابه،",
   "en": "Having worked as a jeweler in his youth,",
   "a": 30.071,
   "b": 33.678
  },
  {
   "p": 1,
   "c": 2,
   "ar": "فاستأجر دكانًا في سوق الجواهر،",
   "en": "the man rented a shop in the jewel market",
   "a": 34.187,
   "b": 37.22
  },
  {
   "p": 1,
   "c": 3,
   "ar": "واشترى بعض البضاعة، وجلس ينتظر الزبائن.",
   "en": "and began trading again.",
   "a": 37.519,
   "b": 42.089
  },
  {
   "p": 2,
   "c": 0,
   "ar": "جاء إلى الدكان ثلاثة رجال، وسألوه عن أبيه.",
   "en": "Three men came asking about his father.",
   "a": 43.263,
   "b": 48.753
  },
  {
   "p": 2,
   "c": 1,
   "ar": "أخبرهم أن والده قد مات، فسألوه إن كان ابنه فعلًا.",
   "en": "Told the father had died,",
   "a": 49.418,
   "b": 55.42
  },
  {
   "p": 2,
   "c": 2,
   "ar": "جمع بعض أهل السوق، فشهدوا أمامهم أن الرجل ابن ذلك التاجر المتوفى.",
   "en": "they asked witnesses from the market to confirm the jeweler was truly his son.",
   "a": 56.08,
   "b": 63.84
  },
  {
   "p": 3,
   "c": 0,
   "ar": "عندئذ سلموه حقيبتين",
   "en": "They handed him two bags",
   "a": 65.167,
   "b": 68.1
  },
  {
   "p": 3,
   "c": 1,
   "ar": "فيهما ثلاثون ألف دينار، وحلي وأحجار نفيسة.",
   "en": "holding thirty thousand dinars and precious jewels,",
   "a": 68.1,
   "b": 74.427
  },
  {
   "p": 3,
   "c": 2,
   "ar": "قالوا إن أباه ترك هذه الأشياء عندهم أمانة قبل وفاته،",
   "en": "saying his late father had entrusted the goods to them",
   "a": 74.844,
   "b": 80.88
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وإنهم جاءوا ليعيدوها إلى وريثه الشرعي.",
   "en": "for his heir.",
   "a": 81.338,
   "b": 85.445
  },
  {
   "p": 4,
   "c": 0,
   "ar": "وبعد قليل حضرت امرأة إلى الدكان،",
   "en": "Soon a woman arrived",
   "a": 86.707,
   "b": 90.66
  },
  {
   "p": 4,
   "c": 1,
   "ar": "واختارت جواهر كان ثمنها خمسمئة دينار، لكنها دفعت ثلاثة آلاف دينار.",
   "en": "and bought jewels worth five hundred dinars for three thousand.",
   "a": 91.416,
   "b": 100.1
  },
  {
   "p": 4,
   "c": 2,
   "ar": "تعجب الرجل من هذه الأحداث،",
   "en": "The astonished jeweler",
   "a": 100.703,
   "b": 103.4
  },
  {
   "p": 4,
   "c": 3,
   "ar": "وشعر أن أبواب الرزق قد فتحت له فجأة.",
   "en": "believed fortune had unexpectedly returned.",
   "a": 103.822,
   "b": 108.1
  },
  {
   "p": 5,
   "c": 0,
   "ar": "حمل خمسمئة دينار إلى صديقه، وقال إنه يريد رد المال الذي اقترضه.",
   "en": "He brought five hundred dinars to repay his friend.",
   "a": 109.429,
   "b": 117.898
  },
  {
   "p": 5,
   "c": 1,
   "ar": "لكن الصديق رفض، وأخبره أنه قدمه هدية منذ البداية،",
   "en": "The friend refused, saying it had been a gift,",
   "a": 118.412,
   "b": 125.02
  },
  {
   "p": 5,
   "c": 2,
   "ar": "ثم أعطاه ورقة وطلب منه ألا يفتحها إلا في بيته.",
   "en": "and handed him a sealed note to read at home.",
   "a": 125.381,
   "b": 131.2
  },
  {
   "p": 6,
   "c": 0,
   "ar": "فتح الرجل الورقة، فوجد فيها أبياتًا تكشف الحقيقة.",
   "en": "At home he read verses revealing the truth.",
   "a": 132.536,
   "b": 139.02
  },
  {
   "p": 6,
   "c": 1,
   "ar": "الثلاثة الذين جاءوا إلى السوق كانوا أقارب صديقه،",
   "en": "The three men were his friend’s relatives,",
   "a": 139.479,
   "b": 144.3
  },
  {
   "p": 6,
   "c": 2,
   "ar": "والمرأة التي اشترت الجواهر كانت أم الصديق،",
   "en": "the buyer was his friend’s mother,",
   "a": 145.287,
   "b": 149.48
  },
  {
   "p": 6,
   "c": 3,
   "ar": "أما الأموال والحلي فقد أرسلها الصديق سرًا.",
   "en": "and all the money and jewels came from his friend.",
   "a": 149.975,
   "b": 154.34
  },
  {
   "p": 7,
   "c": 0,
   "ar": "كتب الصديق أنه دبّر ذلك كله",
   "en": "The note explained that the friend had arranged everything",
   "a": 155.718,
   "b": 159.42
  },
  {
   "p": 7,
   "c": 1,
   "ar": "حتى يساعده من غير أن يحرجه بطلب المال أمامه.",
   "en": "to help without embarrassing him.",
   "a": 159.42,
   "b": 164.723
  },
  {
   "p": 7,
   "c": 2,
   "ar": "فهم الرجل عندها أن ثروته الجديدة لم تكن ميراثًا مجهولًا،",
   "en": "The new fortune was not a forgotten inheritance,",
   "a": 165.649,
   "b": 171.7
  },
  {
   "p": 7,
   "c": 3,
   "ar": "بل ثمرة وفاء صديق حفظ كرامته.",
   "en": "but an act of loyalty that preserved his dignity.",
   "a": 172.124,
   "b": 176.06
  }
 ],
