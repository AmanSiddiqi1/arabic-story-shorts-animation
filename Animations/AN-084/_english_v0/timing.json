{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "خرج معن بن زائدة للصيد في الصحراء،",
   "en": "Ma‘an bin Zaidah went hunting",
   "a": 0,
   "b": 3.7
  },
  {
   "p": 0,
   "c": 1,
   "ar": "وابتعد عن رجاله وهو يطارد غزالًا.",
   "en": "and became separated from his men.",
   "a": 4.281,
   "b": 8.253
  },
  {
   "p": 0,
   "c": 2,
   "ar": "وفي الطريق رأى أعرابيًا يركب حمارًا ويحمل خيارًا طازجًا.",
   "en": "He met a Bedouin on a donkey carrying fresh cucumbers",
   "a": 8.723,
   "b": 15.1
  },
  {
   "p": 0,
   "c": 3,
   "ar": "سلم عليه وسأله إلى أين يذهب.",
   "en": "and asked where he was going.",
   "a": 15.634,
   "b": 19.215
  },
  {
   "p": 1,
   "c": 0,
   "ar": "قال الأعرابي إن بلاده عانت الجفاف سنتين،",
   "en": "The Bedouin said his land had suffered two years of drought",
   "a": 20.466,
   "b": 25.28
  },
  {
   "p": 1,
   "c": 1,
   "ar": "ثم جاء موسم جيد ونضج الخيار مبكرًا.",
   "en": "before an early cucumber harvest.",
   "a": 26.132,
   "b": 30.685
  },
  {
   "p": 1,
   "c": 2,
   "ar": "أراد أن يهديه إلى الأمير معن بن زائدة،",
   "en": "He was taking some to Ma‘an,",
   "a": 31.059,
   "b": 34.98
  },
  {
   "p": 1,
   "c": 3,
   "ar": "لأنه سمع كثيرًا عن كرمه مع الغرباء.",
   "en": "whose generosity he had heard about.",
   "a": 35.618,
   "b": 39.64
  },
  {
   "p": 2,
   "c": 0,
   "ar": "سأله معن، من غير أن يكشف عن هويته:",
   "en": "Without revealing himself,",
   "a": 41.144,
   "b": 45.569
  },
  {
   "p": 2,
   "c": 1,
   "ar": "«كم تتوقع أن يعطيك الأمير؟»",
   "en": "Ma‘an asked what reward he expected.",
   "a": 46.103,
   "b": 48.759
  },
  {
   "p": 2,
   "c": 2,
   "ar": "أجاب الأعرابي: «ألف دينار».",
   "en": "“A thousand dinars,” said the Bedouin.",
   "a": 49.234,
   "b": 52.24
  },
  {
   "p": 2,
   "c": 3,
   "ar": "قال معن: «وإن رأى أن المبلغ كبير؟» فقال: «خمسمئة».",
   "en": "“And if that is too much?” “Five hundred.”",
   "a": 52.746,
   "b": 58.48
  },
  {
   "p": 3,
   "c": 0,
   "ar": "استمر معن يسأله، فنزل الأعرابي إلى ثلاثمئة،",
   "en": "Ma‘an kept asking, and the Bedouin reduced the price",
   "a": 60.29,
   "b": 65.64
  },
  {
   "p": 3,
   "c": 1,
   "ar": "ثم مئتين، ثم مئة، ثم خمسين، وأخيرًا ثلاثين دينارًا.",
   "en": "through three hundred, two hundred, one hundred, fifty and thirty.",
   "a": 66.68,
   "b": 74.1
  },
  {
   "p": 3,
   "c": 2,
   "ar": "قال بعدها إنه لن ينزل أكثر،",
   "en": "Below that,",
   "a": 74.1,
   "b": 78.32
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وإلا دخل بحماره بيت الأمير وعاد خائبًا.",
   "en": "he threatened to bring his donkey into the prince’s house.",
   "a": 78.979,
   "b": 84.12
  },
  {
   "p": 4,
   "c": 0,
   "ar": "ضحك معن وسبق الأعرابي إلى قصره.",
   "en": "Ma‘an laughed, rode back to his palace",
   "a": 85.534,
   "b": 89.6
  },
  {
   "p": 4,
   "c": 1,
   "ar": "أوصى الحارس أن يدخل رجلًا يأتي بالخيار على حمار.",
   "en": "and told the guard to admit a man bringing cucumbers on a donkey.",
   "a": 90.703,
   "b": 95.72
  },
  {
   "p": 4,
   "c": 2,
   "ar": "وبعد قليل وصل الأعرابي،",
   "en": "The Bedouin arrived",
   "a": 96.258,
   "b": 99.071
  },
  {
   "p": 4,
   "c": 3,
   "ar": "فرأى الأمير جالسًا على عرشه وبين يديه الخدم والرجال.",
   "en": "and saw the prince on his throne.",
   "a": 99.878,
   "b": 105.6
  },
  {
   "p": 5,
   "c": 0,
   "ar": "لم يعرفه الأعرابي في البداية، وقدم له الخيار.",
   "en": "The Bedouin did not recognize him at first.",
   "a": 106.987,
   "b": 112.32
  },
  {
   "p": 5,
   "c": 1,
   "ar": "سأله الأمير عن الثمن، فطلب ألف دينار.",
   "en": "He offered the cucumbers and asked for a thousand dinars.",
   "a": 112.941,
   "b": 117.64
  },
  {
   "p": 5,
   "c": 2,
   "ar": "أخذ معن يرفض كل مبلغ،",
   "en": "Ma‘an bargained him down",
   "a": 118.2,
   "b": 121.16
  },
  {
   "p": 5,
   "c": 3,
   "ar": "حتى وصل الأعرابي مرة أخرى إلى ثلاثين دينارًا ورفض النزول أكثر.",
   "en": "again to thirty.",
   "a": 121.663,
   "b": 128.78
  },
  {
   "p": 6,
   "c": 0,
   "ar": "فجأة عرف الأعرابي أن الأمير هو الرجل الذي قابله في الصحراء.",
   "en": "Suddenly recognizing the hunter,",
   "a": 130.129,
   "b": 136.78
  },
  {
   "p": 6,
   "c": 1,
   "ar": "قال ضاحكًا: «إذا لم تعطِني الثلاثين،",
   "en": "the Bedouin joked that his donkey was waiting outside,",
   "a": 137.423,
   "b": 141.0
  },
  {
   "p": 6,
   "c": 2,
   "ar": "فحماري مربوط عند الباب، وسيدخل بيتك كما وعدت!»",
   "en": "ready to enter the palace.",
   "a": 141.0,
   "b": 146.684
  },
  {
   "p": 6,
   "c": 3,
   "ar": "فضحك معن حتى مال إلى الخلف.",
   "en": "Ma‘an laughed heartily.",
   "a": 147.12,
   "b": 150.4
  },
  {
   "p": 7,
   "c": 0,
   "ar": "نادى معن أمين ماله،",
   "en": "Ma‘an ordered payment",
   "a": 151.746,
   "b": 154.075
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وأمره أن يعطي الأعرابي كل المبالغ التي ذكرها، لا آخر مبلغ فقط.",
   "en": "of every amount named, not merely thirty.",
   "a": 154.775,
   "b": 162.34
  },
  {
   "p": 7,
   "c": 2,
   "ar": "جمع الرجل ألفًا وخمسمئة وثلاثمئة ومئتين ومئة وخمسين وثلاثين دينارًا،",
   "en": "The Bedouin received 2,180 dinars in total",
   "a": 163.072,
   "b": 172.34
  },
  {
   "p": 7,
   "c": 3,
   "ar": "وعاد متعجبًا بثروة كبيرة.",
   "en": "and returned home amazed by his fortune.",
   "a": 172.34,
   "b": 175.26
  }
 ],
