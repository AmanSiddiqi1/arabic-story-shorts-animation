{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "خرج الأمير معن بن زائدة في يوم حار للصيد مع رجاله.",
   "en": "The prince Ma‘an bin Zaidah went hunting on a hot day.",
   "a": 0,
   "b": 6.105
  },
  {
   "p": 0,
   "c": 1,
   "ar": "ابتعدوا في الصحراء، واشتد بهم العطش.",
   "en": "He and his men grew thirsty",
   "a": 7.049,
   "b": 11.14
  },
  {
   "p": 0,
   "c": 2,
   "ar": "بحثوا عن الماء في أوعيتهم، لكنهم لم يجدوا ما يكفي حتى يشرب الأمير.",
   "en": "and found no water to drink.",
   "a": 12.058,
   "b": 19.64
  },
  {
   "p": 1,
   "c": 0,
   "ar": "وبينما هم يسيرون، ظهرت ثلاث فتيات يحملن قربًا من الماء على أكتافهن.",
   "en": "Three girls appeared carrying waterskins.",
   "a": 20.96,
   "b": 29.02
  },
  {
   "p": 1,
   "c": 1,
   "ar": "اقترب منهن معن وطلب قليلًا من الماء.",
   "en": "Ma‘an asked for a drink,",
   "a": 29.02,
   "b": 33.74
  },
  {
   "p": 1,
   "c": 2,
   "ar": "لم يسألنه عن اسمه، بل قدمن إليه الماء فورًا.",
   "en": "and without asking his identity they gave him water.",
   "a": 34.376,
   "b": 39.165
  },
  {
   "p": 2,
   "c": 0,
   "ar": "شرب معن حتى ذهب عطشه،",
   "en": "After drinking,",
   "a": 40.422,
   "b": 43.96
  },
  {
   "p": 2,
   "c": 1,
   "ar": "ثم أراد أن يشكر الفتيات على معروفهن.",
   "en": "he wanted to repay their kindness.",
   "a": 44.842,
   "b": 48.813
  },
  {
   "p": 2,
   "c": 2,
   "ar": "التفت إلى رجاله وطلب مالًا ليعطيهن،",
   "en": "He asked his men for money,",
   "a": 49.365,
   "b": 53.933
  },
  {
   "p": 2,
   "c": 3,
   "ar": "لكن الرجال لم يحملوا معهم نقودًا في رحلة الصيد.",
   "en": "but they had brought none on the hunt.",
   "a": 54.534,
   "b": 59.42
  },
  {
   "p": 3,
   "c": 0,
   "ar": "فكر الأمير قليلًا، ثم فتح جعبة سهامه.",
   "en": "The prince opened his quiver.",
   "a": 60.865,
   "b": 65.84
  },
  {
   "p": 3,
   "c": 1,
   "ar": "كانت رؤوس السهام مصنوعة من الذهب.",
   "en": "His arrows had golden tips,",
   "a": 66.325,
   "b": 69.964
  },
  {
   "p": 3,
   "c": 2,
   "ar": "أعطى كل فتاة عشرة سهام،",
   "en": "so he gave each girl ten,",
   "a": 70.622,
   "b": 73.64
  },
  {
   "p": 3,
   "c": 3,
   "ar": "فحصلت الفتيات الثلاث على ثلاثين سهمًا ثمينًا بدل النقود.",
   "en": "thirty valuable arrows in all.",
   "a": 74.079,
   "b": 80.24
  },
  {
   "p": 4,
   "c": 0,
   "ar": "نظرت الفتيات إلى السهام بدهشة.",
   "en": "The girls were astonished.",
   "a": 81.57,
   "b": 84.74
  },
  {
   "p": 4,
   "c": 1,
   "ar": "قالت إحداهن لصاحبتَيها: «لا يفعل هذا إلا معن بن زائدة،",
   "en": "One said only Ma‘an,",
   "a": 85.591,
   "b": 92.06
  },
  {
   "p": 4,
   "c": 2,
   "ar": "الذي يعرفه الناس بكرمه.",
   "en": "famed for generosity,",
   "a": 92.452,
   "b": 94.68
  },
  {
   "p": 4,
   "c": 3,
   "ar": "حتى سهامه التي يستعملها في الحرب تحمل الذهب!»",
   "en": "would give away gold even from arrows used in war.",
   "a": 95.272,
   "b": 100.18
  },
  {
   "p": 5,
   "c": 0,
   "ar": "اتفقت الفتيات على أن تشكره كل واحدة بكلمات من الشعر.",
   "en": "They decided to thank him in verse.",
   "a": 101.525,
   "b": 107.941
  },
  {
   "p": 5,
   "c": 1,
   "ar": "أنشدت الأولى أبياتًا تصف رجلًا يجعل سهامه الذهبية عونًا للمحتاجين،",
   "en": "The first praised a warrior whose golden arrows could help",
   "a": 108.895,
   "b": 116.54
  },
  {
   "p": 5,
   "c": 2,
   "ar": "حتى عندما يخرج لملاقاة أعدائه في القتال.",
   "en": "even those wounded in battle.",
   "a": 116.937,
   "b": 121.34
  },
  {
   "p": 6,
   "c": 0,
   "ar": "ثم أنشدت الثانية أبياتًا تقول إن الأمير يعطي بسخاء للأصدقاء والأعداء،",
   "en": "The second praised his generosity",
   "a": 122.692,
   "b": 131.2
  },
  {
   "p": 6,
   "c": 1,
   "ar": "ولا يتوقف كرمه في أوقات الحرب.",
   "en": "toward friends and enemies;",
   "a": 131.712,
   "b": 135.34
  },
  {
   "p": 6,
   "c": 2,
   "ar": "أما الثالثة فوصفت كيف يمكن أن يدفع الذهب ثمن علاج المصاب",
   "en": "the third said the gold could pay for a wounded person’s treatment",
   "a": 135.933,
   "b": 142.52
  },
  {
   "p": 6,
   "c": 3,
   "ar": "أو كفن الميت.",
   "en": "or a dead person’s shroud.",
   "a": 142.52,
   "b": 144.06
  },
  {
   "p": 7,
   "c": 0,
   "ar": "استمع معن إلى ثناء الفتيات بعدما سقينه وهو عطشان.",
   "en": "Ma‘an heard their praise after their kindness to him.",
   "a": 145.598,
   "b": 151.68
  },
  {
   "p": 7,
   "c": 1,
   "ar": "عرفن هويته من هديته،",
   "en": "They had recognized him by his gift,",
   "a": 152.764,
   "b": 155.5
  },
  {
   "p": 7,
   "c": 2,
   "ar": "لا من ثيابه أو مرافقيه.",
   "en": "not his clothing or attendants.",
   "a": 155.981,
   "b": 158.56
  },
  {
   "p": 7,
   "c": 3,
   "ar": "وبقيت السهام الذهبية معهن، ذكرى اللقاء في الصحراء.",
   "en": "The golden arrows remained with them as a memory of the meeting.",
   "a": 159.61,
   "b": 165.13
  }
 ],
