{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان رجل صالح من بني إسرائيل",
   "en": "A devout Israelite",
   "a": 0,
   "b": 3.06
  },
  {
   "p": 0,
   "c": 1,
   "ar": "يعيش مع أسرته من غزل القطن.",
   "en": "supported his family by selling the cotton thread they spun.",
   "a": 3.06,
   "b": 6.54
  },
  {
   "p": 0,
   "c": 2,
   "ar": "كانت أسرته تغزل الخيوط كل يوم، فيبيعها،",
   "en": "He used the proceeds",
   "a": 7.473,
   "b": 12.488
  },
  {
   "p": 0,
   "c": 3,
   "ar": "ثم يشتري قطنًا جديدًا وطعامًا بما يبقى من المال ليكفيهم يومهم.",
   "en": "to buy more cotton and enough food for the day.",
   "a": 13.28,
   "b": 20.12
  },
  {
   "p": 1,
   "c": 0,
   "ar": "وفي صباح خرج الرجل ليبيع الخيوط كما اعتاد.",
   "en": "One morning",
   "a": 21.468,
   "b": 26.5
  },
  {
   "p": 1,
   "c": 1,
   "ar": "قابله صديق يشكو الفقر والحاجة،",
   "en": "a friend complained of desperate need.",
   "a": 27.228,
   "b": 30.859
  },
  {
   "p": 1,
   "c": 2,
   "ar": "فتأثر بحاله وأعطاه كل ما قبضه من ثمن الغزل،",
   "en": "The man gave him all the money from that day’s thread",
   "a": 31.276,
   "b": 36.785
  },
  {
   "p": 1,
   "c": 3,
   "ar": "ثم رجع إلى البيت دون طعام أو قطن.",
   "en": "and returned home without food or fresh cotton.",
   "a": 37.39,
   "b": 41.432
  },
  {
   "p": 2,
   "c": 0,
   "ar": "سألته أسرته عما حدث،",
   "en": "His family wondered",
   "a": 42.621,
   "b": 45.415
  },
  {
   "p": 2,
   "c": 1,
   "ar": "فأخبرهم أنه ساعد رجلًا محتاجًا.",
   "en": "how they would eat.",
   "a": 46.34,
   "b": 49.9
  },
  {
   "p": 2,
   "c": 2,
   "ar": "لم يبق في البيت شيء يمكن بيعه إلا طبق خشبي متشقق وجرة قديمة،",
   "en": "Only a cracked wooden platter and an old jar remained to sell,",
   "a": 50.642,
   "b": 58.855
  },
  {
   "p": 2,
   "c": 3,
   "ar": "فأخذهما إلى السوق، لكن أحدًا لم يرغب فيهما.",
   "en": "but nobody in the market would buy them.",
   "a": 59.581,
   "b": 64.68
  },
  {
   "p": 3,
   "c": 0,
   "ar": "رأى بائع سمك يعرض سمكة منتفخة ذات رائحة كريهة،",
   "en": "A fish seller had a swollen, foul-smelling fish",
   "a": 66.057,
   "b": 72.823
  },
  {
   "p": 3,
   "c": 1,
   "ar": "ولم يجد من يشتريها.",
   "en": "that no one wanted.",
   "a": 73.409,
   "b": 75.38
  },
  {
   "p": 3,
   "c": 2,
   "ar": "اتفق الرجلان على تبديل السلع،",
   "en": "They exchanged their unwanted goods,",
   "a": 75.934,
   "b": 79.06
  },
  {
   "p": 3,
   "c": 3,
   "ar": "فأخذ الرجل السمكة، وترك للبائع الطبق والجرة، ثم عاد إلى أسرته.",
   "en": "and the man carried the fish home.",
   "a": 79.628,
   "b": 87.117
  },
  {
   "p": 4,
   "c": 0,
   "ar": "فتحت الأسرة بطن السمكة لتعدها للطعام،",
   "en": "When the family opened the fish,",
   "a": 88.371,
   "b": 92.98
  },
  {
   "p": 4,
   "c": 1,
   "ar": "فوجدت لؤلؤة كبيرة داخلها.",
   "en": "they discovered a large pearl.",
   "a": 93.591,
   "b": 96.96
  },
  {
   "p": 4,
   "c": 2,
   "ar": "فحصها الرجل، ورأى أنها لم تثقب من قبل.",
   "en": "It had never been drilled.",
   "a": 97.582,
   "b": 102.34
  },
  {
   "p": 4,
   "c": 3,
   "ar": "وفي اليوم التالي حملها إلى خبير بالأحجار الكريمة ليسأله عن قيمتها.",
   "en": "The next day the man took it to a jewel expert.",
   "a": 102.917,
   "b": 109.96
  },
  {
   "p": 5,
   "c": 0,
   "ar": "قال الخبير إن اللؤلؤة ثمينة،",
   "en": "The expert",
   "a": 111.298,
   "b": 114.649
  },
  {
   "p": 5,
   "c": 1,
   "ar": "لكنه نصحه بزيارة تاجر يملك مالًا أكثر.",
   "en": "recommended a wealthier buyer.",
   "a": 115.532,
   "b": 120.54
  },
  {
   "p": 5,
   "c": 2,
   "ar": "ذهب الرجل إليه، فدفع له سبعين ألف درهم مقابل اللؤلؤة،",
   "en": "That merchant paid seventy thousand dirhams for the pearl,",
   "a": 121.099,
   "b": 127.84
  },
  {
   "p": 5,
   "c": 3,
   "ar": "وعاد إلى بيته يحمل ثروة لم يتوقعها.",
   "en": "giving the family a fortune they had never imagined.",
   "a": 128.275,
   "b": 133.0
  },
  {
   "p": 6,
   "c": 0,
   "ar": "عند باب البيت قابله فقير وطلب منه صدقة.",
   "en": "At his door a beggar asked for help.",
   "a": 134.33,
   "b": 139.3
  },
  {
   "p": 6,
   "c": 1,
   "ar": "تذكر الرجل كيف كان محتاجًا بالأمس،",
   "en": "Remembering his own poverty,",
   "a": 140.384,
   "b": 144.02
  },
  {
   "p": 6,
   "c": 2,
   "ar": "فقسم المال نصفين، وقدم نصفه للفقير دون تردد، مع أن أسرته عانت الجوع منذ وقت قريب.",
   "en": "the man immediately divided the money in half and offered the beggar one share.",
   "a": 144.464,
   "b": 155.64
  },
  {
   "p": 7,
   "c": 0,
   "ar": "لكن الفقير أعاد المال إليه،",
   "en": "The beggar returned the money",
   "a": 156.856,
   "b": 159.948
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وقال إنه رسول أرسل لاختبار كرمه، وإنه نجح في الامتحان.",
   "en": "and revealed he was a messenger sent to test the man’s generosity.",
   "a": 160.669,
   "b": 167.82
  },
  {
   "p": 7,
   "c": 2,
   "ar": "شكر الرجل الله، وعاش مع أسرته في راحة،",
   "en": "The family lived comfortably,",
   "a": 168.419,
   "b": 172.978
  },
  {
   "p": 7,
   "c": 3,
   "ar": "بعدما ظل مستعدًا للعطاء حتى بعد غناه.",
   "en": "and the man’s willingness to share had endured.",
   "a": 173.402,
   "b": 177.72
  }
 ],
