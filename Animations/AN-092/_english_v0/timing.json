{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "لم يستطع الخليفة هارون الرشيد النوم ذات ليلة،",
   "en": "One sleepless night Caliph Harun al-Rashid",
   "a": 0,
   "b": 4.824
  },
  {
   "p": 0,
   "c": 1,
   "ar": "فطلب من وزيره جعفر قصة تضحكه وتخفف عنه الهم.",
   "en": "asked Ja’far for an amusing story.",
   "a": 5.712,
   "b": 11.8
  },
  {
   "p": 0,
   "c": 2,
   "ar": "اقترح جعفر استدعاء رجل يعرف الحكايات الطريفة اسمه علي الفارسي،",
   "en": "Ja’far brought Ali the Persian,",
   "a": 12.436,
   "b": 20.104
  },
  {
   "p": 0,
   "c": 3,
   "ar": "فحضر علي وجلس أمام الخليفة.",
   "en": "a man known for entertaining tales.",
   "a": 20.694,
   "b": 23.98
  },
  {
   "p": 1,
   "c": 0,
   "ar": "قال علي إنه سافر يومًا يحمل كيسًا جلديًا صغيرًا فيه زاده.",
   "en": "Ali recalled traveling with a small leather bag of provisions.",
   "a": 25.211,
   "b": 32.262
  },
  {
   "p": 1,
   "c": 1,
   "ar": "وبينما كان يشتري من سوق مدينة غريبة،",
   "en": "At a market,",
   "a": 33.228,
   "b": 36.98
  },
  {
   "p": 1,
   "c": 2,
   "ar": "أمسك به رجل كردي وانتزع الكيس منه،",
   "en": "a Kurdish stranger seized it",
   "a": 37.414,
   "b": 41.643
  },
  {
   "p": 1,
   "c": 3,
   "ar": "وادعى أمام الناس أنه صاحبه الحقيقي.",
   "en": "and loudly claimed ownership.",
   "a": 42.269,
   "b": 46.553
  },
  {
   "p": 2,
   "c": 0,
   "ar": "احتكم الخصمان إلى القاضي،",
   "en": "They appeared before a judge,",
   "a": 47.772,
   "b": 50.494
  },
  {
   "p": 2,
   "c": 1,
   "ar": "فسأل المدعي عن محتويات الكيس. بدأ الرجل يعدد أشياء معقولة،",
   "en": "who asked the claimant to describe the contents.",
   "a": 51.322,
   "b": 58.363
  },
  {
   "p": 2,
   "c": 2,
   "ar": "ثم زعم أن فيه خيمتين وبساطين وبقرة وعجلين",
   "en": "The man listed tents, rugs, cattle,",
   "a": 58.934,
   "b": 65.1
  },
  {
   "p": 2,
   "c": 3,
   "ar": "وأغنامًا وجمالًا وسباعًا، بل وغرفًا كاملة داخل الكيس الصغير.",
   "en": "camels, wild beasts, and even rooms.",
   "a": 65.1,
   "b": 72.94
  },
  {
   "p": 3,
   "c": 0,
   "ar": "صُعق علي من المبالغة، لكنه رد بمبالغة أكبر.",
   "en": "Astonished, Ali retaliated with a grander inventory:",
   "a": 74.258,
   "b": 80.44
  },
  {
   "p": 3,
   "c": 1,
   "ar": "قال إن كيسه يحوي بيتًا قديمًا ومدرسة وحديقة",
   "en": "houses, a school, gardens,",
   "a": 81.071,
   "b": 86.84
  },
  {
   "p": 3,
   "c": 2,
   "ar": "ومدينة بغداد ومدينة البصرة، وجيوشًا من الجنود،",
   "en": "Baghdad, Basra, armies,",
   "a": 86.84,
   "b": 92.44
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وآلاف الناس الذين يشهدون أنه ملكه.",
   "en": "and thousands of witnesses—all supposedly in his bag.",
   "a": 92.44,
   "b": 96.7
  },
  {
   "p": 4,
   "c": 0,
   "ar": "نفد صبر القاضي، وقال إن أحدًا لم يسمع قط ادعاءات بهذه الغرابة.",
   "en": "The judge finally asked",
   "a": 98.027,
   "b": 106.08
  },
  {
   "p": 4,
   "c": 1,
   "ar": "سأل الرجلين: هل هذا الكيس بحر بلا قرار",
   "en": "whether this was a bottomless sea",
   "a": 106.746,
   "b": 111.3
  },
  {
   "p": 4,
   "c": 2,
   "ar": "أم مكان يجتمع فيه الناس جميعًا؟",
   "en": "or a place containing all humanity.",
   "a": 111.716,
   "b": 114.82
  },
  {
   "p": 4,
   "c": 3,
   "ar": "ثم أمرهما بفتحه أمام المجلس.",
   "en": "He ordered the bag opened before the court.",
   "a": 115.504,
   "b": 118.88
  },
  {
   "p": 5,
   "c": 0,
   "ar": "فتح علي الكيس، فلم يجد فيه أحد مدينة ولا حيوانًا ولا جيشًا.",
   "en": "The bag contained no cities or animals—only",
   "a": 120.097,
   "b": 128.3
  },
  {
   "p": 5,
   "c": 1,
   "ar": "لم يكن داخله إلا خبز وقليل من الجبن وزيتون وحبة ليمون.",
   "en": "bread, cheese, olives, and a lemon.",
   "a": 128.938,
   "b": 136.22
  },
  {
   "p": 5,
   "c": 2,
   "ar": "ألقى علي الكيس أمام خصمه وانصرف، تاركًا القاضي يواجه سخافة النزاع.",
   "en": "Ali dropped it before his rival and walked away.",
   "a": 137.224,
   "b": 144.92
  },
  {
   "p": 6,
   "c": 0,
   "ar": "انفجر هارون الرشيد ضاحكًا حين وصل علي إلى نهاية قصته،",
   "en": "Harun al-Rashid laughed heartily at the ending",
   "a": 146.254,
   "b": 152.4
  },
  {
   "p": 6,
   "c": 1,
   "ar": "وأعطاه هدية سخية.",
   "en": "and rewarded Ali.",
   "a": 152.857,
   "b": 155.28
  },
  {
   "p": 6,
   "c": 2,
   "ar": "وهكذا انتهت خصومة الكيس الصغير، لا بحكم معقد،",
   "en": "A simple inspection",
   "a": 155.92,
   "b": 161.56
  },
  {
   "p": 6,
   "c": 3,
   "ar": "بل بكشف بسيط فضح ادعاءين لا يمكن تصديقهما.",
   "en": "had exposed both men’s absurd claims.",
   "a": 161.99,
   "b": 167.4
  }
 ],
