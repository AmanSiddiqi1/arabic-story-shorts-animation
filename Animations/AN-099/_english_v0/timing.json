{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان الخليفة المأمون يحب العلم،",
   "en": "Caliph al-Maamun loved learning",
   "a": 0,
   "b": 3.36
  },
  {
   "p": 0,
   "c": 1,
   "ar": "ويجمع العلماء في مجلسه مرتين كل أسبوع ليتناقشوا في المسائل الصعبة.",
   "en": "and assembled scholars twice a week.",
   "a": 4.374,
   "b": 11.86
  },
  {
   "p": 0,
   "c": 2,
   "ar": "وفي أحد المجالس دخل رجل غريب تبدو عليه علامات الفقر،",
   "en": "One day an unknown man in poor clothing entered",
   "a": 12.511,
   "b": 18.7
  },
  {
   "p": 0,
   "c": 3,
   "ar": "وجلس بعيدًا عن الجميع.",
   "en": "and sat far from the others.",
   "a": 19.232,
   "b": 21.56
  },
  {
   "p": 1,
   "c": 0,
   "ar": "لم يلتفت إليه أكثر الحاضرين،",
   "en": "Few noticed him,",
   "a": 22.929,
   "b": 25.92
  },
  {
   "p": 1,
   "c": 1,
   "ar": "فقد ظنوا أن ثيابه البسيطة تدل على قلة علمه.",
   "en": "assuming his simple clothing meant little education.",
   "a": 26.562,
   "b": 31.696
  },
  {
   "p": 1,
   "c": 2,
   "ar": "بدأ النقاش، وطرح الخليفة سؤالًا",
   "en": "The debate began, and the caliph posed a question",
   "a": 32.256,
   "b": 36.12
  },
  {
   "p": 1,
   "c": 3,
   "ar": "عجز بعض العلماء عن الإجابة عنه إجابة واضحة ومقنعة.",
   "en": "that several scholars could not answer clearly.",
   "a": 36.12,
   "b": 42.56
  },
  {
   "p": 2,
   "c": 0,
   "ar": "رفع الغريب يده بهدوء، واستأذن في الكلام.",
   "en": "The stranger asked permission to speak.",
   "a": 43.828,
   "b": 48.84
  },
  {
   "p": 2,
   "c": 1,
   "ar": "ثم قدم جوابًا دقيقًا، وشرح أسبابه بألفاظ سهلة.",
   "en": "His precise, plainly explained answer",
   "a": 49.364,
   "b": 55.62
  },
  {
   "p": 2,
   "c": 2,
   "ar": "أعجب المأمون بفهمه،",
   "en": "impressed al-Maamun,",
   "a": 56.198,
   "b": 58.28
  },
  {
   "p": 2,
   "c": 3,
   "ar": "ودعاه إلى الجلوس في مكان أقرب إلى العلماء.",
   "en": "who invited him to sit nearer the scholars.",
   "a": 58.704,
   "b": 63.0
  },
  {
   "p": 3,
   "c": 0,
   "ar": "جاء سؤال ثان، فاختلف الحاضرون في تفسيره.",
   "en": "A second question divided the gathering.",
   "a": 64.359,
   "b": 69.484
  },
  {
   "p": 3,
   "c": 1,
   "ar": "تكلم الرجل مرة أخرى، وجمع بين الأدلة حتى اتضح المعنى.",
   "en": "The stranger weighed the evidence and clarified the answer.",
   "a": 69.946,
   "b": 76.44
  },
  {
   "p": 3,
   "c": 2,
   "ar": "أشار الخليفة إليه أن يتقدم،",
   "en": "The caliph moved him closer still,",
   "a": 76.95,
   "b": 79.98
  },
  {
   "p": 3,
   "c": 3,
   "ar": "وأصبح موضع اهتمام من كانوا يتجاهلونه.",
   "en": "and those who ignored him took notice.",
   "a": 80.464,
   "b": 84.6
  },
  {
   "p": 4,
   "c": 0,
   "ar": "وفي السؤال الثالث أظهر الغريب علمًا أوسع مما توقعه الجميع،",
   "en": "His third answer surpassed expectations.",
   "a": 85.871,
   "b": 91.98
  },
  {
   "p": 4,
   "c": 1,
   "ar": "فدعاه المأمون للجلوس إلى جانبه.",
   "en": "Al-Maamun invited him beside him.",
   "a": 92.858,
   "b": 96.14
  },
  {
   "p": 4,
   "c": 2,
   "ar": "عند انتهاء المناظرة، جلسوا إلى الطعام،",
   "en": "After the debate, the company ate together,",
   "a": 96.726,
   "b": 100.58
  },
  {
   "p": 4,
   "c": 3,
   "ar": "وصار الرجل ضيفًا مكرمًا بدل الغريب المنسي.",
   "en": "and the forgotten stranger became an honored guest.",
   "a": 100.965,
   "b": 105.42
  },
  {
   "p": 5,
   "c": 0,
   "ar": "ثم انتقل المجلس إلى الشراب،",
   "en": "The gathering then turned to drinking.",
   "a": 106.742,
   "b": 109.42
  },
  {
   "p": 5,
   "c": 1,
   "ar": "وعرض الخليفة على ضيفه كأسًا من الخمر كما كان يفعل مع بعض جلسائه.",
   "en": "The caliph offered his guest a cup of wine.",
   "a": 110.074,
   "b": 117.34
  },
  {
   "p": 5,
   "c": 2,
   "ar": "اعتذر الرجل بأدب، ولم يتناول الكأس،",
   "en": "The man politely refused,",
   "a": 118.13,
   "b": 122.42
  },
  {
   "p": 5,
   "c": 3,
   "ar": "فتعجب المأمون وسأله عن السبب.",
   "en": "and al-Maamun asked him why.",
   "a": 122.949,
   "b": 126.5
  },
  {
   "p": 6,
   "c": 0,
   "ar": "أجاب العالم: يا أمير المؤمنين،",
   "en": "The scholar replied:",
   "a": 127.776,
   "b": 131.26
  },
  {
   "p": 6,
   "c": 1,
   "ar": "لم تقربني منك ثيابي ولا مالي، بل عقلي وعلمي.",
   "en": "It was neither wealth nor clothing that brought me near you, but my mind and knowledge.",
   "a": 132.203,
   "b": 138.295
  },
  {
   "p": 6,
   "c": 2,
   "ar": "فإذا شربت ما يذهب عقلي،",
   "en": "Why drink something",
   "a": 139.136,
   "b": 141.58
  },
  {
   "p": 6,
   "c": 3,
   "ar": "فقد أفسدت الشيء الذي رفعني في مجلسك هذا اليوم.",
   "en": "that could take away what earned your respect?",
   "a": 142.043,
   "b": 147.005
  },
  {
   "p": 7,
   "c": 0,
   "ar": "سر الخليفة بجوابه أكثر من سروره بأجوبته العلمية،",
   "en": "The caliph admired this answer even more",
   "a": 148.29,
   "b": 154.563
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وأمر له بمئة ألف قطعة من الفضة.",
   "en": "and awarded him one hundred thousand silver coins.",
   "a": 155.115,
   "b": 159.213
  },
  {
   "p": 7,
   "c": 2,
   "ar": "خرج الرجل مكرمًا،",
   "en": "The scholar departed honored,",
   "a": 159.674,
   "b": 161.72
  },
  {
   "p": 7,
   "c": 3,
   "ar": "بعدما حفظ بعلمه مكانته، ثم حفظ بعقله سبب تلك المكانة.",
   "en": "having protected the very reason for his rise.",
   "a": 162.26,
   "b": 169.34
  }
 ],
