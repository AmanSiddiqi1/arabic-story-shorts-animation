{
 "chunks": [
  {
   "p": 0,
   "c": 0,
   "ar": "كان رجل فقير من العراق",
   "en": "A poor Iraqi man",
   "a": 0,
   "b": 2.76
  },
  {
   "p": 0,
   "c": 1,
   "ar": "يبحث عن وسيلة يخرج بها من ضيق العيش.",
   "en": "sought a way out of hardship.",
   "a": 2.76,
   "b": 6.92
  },
  {
   "p": 0,
   "c": 2,
   "ar": "سمع عن والي أرمينية عبد الله بن مالك،",
   "en": "He heard of Abdullah ibn Malik, governor of Armenia,",
   "a": 7.963,
   "b": 12.07
  },
  {
   "p": 0,
   "c": 3,
   "ar": "وعن خلاف قديم بينه وبين الوزير يحيى بن خالد البرمكي.",
   "en": "and his long-standing quarrel with Yahya al-Barmaki.",
   "a": 12.321,
   "b": 18.44
  },
  {
   "p": 1,
   "c": 0,
   "ar": "كتب الرجل رسالة مزورة،",
   "en": "The man forged a letter",
   "a": 19.661,
   "b": 22.51
  },
  {
   "p": 1,
   "c": 1,
   "ar": "وجعلها كأنها من يحيى إلى الوالي، يطلب فيها إكرام حاملها ومساعدته.",
   "en": "supposedly from Yahya requesting help for its bearer.",
   "a": 23.491,
   "b": 31.409
  },
  {
   "p": 1,
   "c": 2,
   "ar": "ثم سافر مسافة طويلة،",
   "en": "After a long journey,",
   "a": 32.016,
   "b": 35.02
  },
  {
   "p": 1,
   "c": 3,
   "ar": "ودخل على عبد الله وقدم إليه الرسالة بثقة.",
   "en": "he presented it confidently to Governor Abdullah.",
   "a": 35.02,
   "b": 39.76
  },
  {
   "p": 2,
   "c": 0,
   "ar": "قرأ عبد الله الخطاب، وشك في صحته،",
   "en": "Abdullah doubted the letter",
   "a": 41.185,
   "b": 45.72
  },
  {
   "p": 2,
   "c": 1,
   "ar": "لأنه يعرف الخصومة التي بينه وبين يحيى.",
   "en": "because of his feud with Yahya.",
   "a": 46.147,
   "b": 50.42
  },
  {
   "p": 2,
   "c": 2,
   "ar": "قال للرجل: إن كانت الرسالة صحيحة أكرمتك،",
   "en": "He promised a great reward if it was genuine,",
   "a": 51.148,
   "b": 56.36
  },
  {
   "p": 2,
   "c": 3,
   "ar": "وإن كانت كذبًا فلك عقاب شديد.",
   "en": "but severe punishment if it was false.",
   "a": 56.741,
   "b": 60.494
  },
  {
   "p": 3,
   "c": 0,
   "ar": "أقام الرجل عند الوالي ينتظر النتيجة،",
   "en": "The man waited",
   "a": 61.781,
   "b": 65.753
  },
  {
   "p": 3,
   "c": 1,
   "ar": "بينما أرسل عبد الله رسولًا إلى بغداد ليسأل يحيى بنفسه.",
   "en": "while Abdullah sent an envoy to Baghdad.",
   "a": 66.629,
   "b": 72.598
  },
  {
   "p": 3,
   "c": 2,
   "ar": "مرت الأيام ثقيلة على الرجل؛",
   "en": "Each day felt long:",
   "a": 73.257,
   "b": 76.24
  },
  {
   "p": 3,
   "c": 3,
   "ar": "فالجواب قد يجلب له ثروة، أو يعرضه للضرب والإهانة.",
   "en": "Yahya’s answer could bring him wealth or expose him to a humiliating beating.",
   "a": 76.76,
   "b": 83.037
  },
  {
   "p": 4,
   "c": 0,
   "ar": "فهم يحيى الأمر حين قرأ الرسالة، وعرف أنها ليست من كتابته.",
   "en": "Yahya immediately recognized the forgery.",
   "a": 84.254,
   "b": 91.04
  },
  {
   "p": 4,
   "c": 1,
   "ar": "لكنه رأى فيها فرصة لإنهاء العداوة،",
   "en": "Yet he saw a chance for peace",
   "a": 91.644,
   "b": 95.753
  },
  {
   "p": 4,
   "c": 2,
   "ar": "فقال للرسول إنها رسالته حقًا،",
   "en": "and told the envoy the letter was indeed his,",
   "a": 96.121,
   "b": 100.115
  },
  {
   "p": 4,
   "c": 3,
   "ar": "وأوصى الوالي بأن يحسن معاملة حاملها.",
   "en": "urging Abdullah to honor its bearer.",
   "a": 100.475,
   "b": 104.44
  },
  {
   "p": 5,
   "c": 0,
   "ar": "فرح عبد الله بهذا الجواب، وأعطى الرجل مئتي ألف درهم،",
   "en": "Delighted, Abdullah gave the man two hundred thousand dirhams,",
   "a": 105.83,
   "b": 112.12
  },
  {
   "p": 5,
   "c": 1,
   "ar": "وعشرة خيول عربية، وصناديق من الثياب، وخدمًا وجواهر.",
   "en": "ten Arabian horses, chests of clothes, servants and jewels.",
   "a": 112.419,
   "b": 119.68
  },
  {
   "p": 5,
   "c": 2,
   "ar": "وأصبح اسم يحيى، الذي كان سببًا للخلاف، سببًا لتجدد المودة بين الرجلين.",
   "en": "The estranged men began to reconcile.",
   "a": 120.34,
   "b": 128.908
  },
  {
   "p": 6,
   "c": 0,
   "ar": "عاد الرجل إلى بغداد وهو لا يكاد يصدق ما حدث.",
   "en": "Back in Baghdad, the astonished man",
   "a": 130.099,
   "b": 135.4
  },
  {
   "p": 6,
   "c": 1,
   "ar": "ذهب إلى يحيى، واعترف بما صنع،",
   "en": "admitted his trick to Yahya,",
   "a": 136.326,
   "b": 140.08
  },
  {
   "p": 6,
   "c": 2,
   "ar": "وشكره على إنقاذه من العقوبة.",
   "en": "thanked him for saving him from punishment,",
   "a": 140.64,
   "b": 143.703
  },
  {
   "p": 6,
   "c": 3,
   "ar": "ثم عرض عليه شيئًا من الهدايا الكثيرة التي حصل عليها.",
   "en": "and offered him part of his gifts.",
   "a": 144.204,
   "b": 149.82
  },
  {
   "p": 7,
   "c": 0,
   "ar": "ابتسم يحيى ورفض أن يأخذ شيئًا،",
   "en": "Yahya refused.",
   "a": 151.173,
   "b": 154.99
  },
  {
   "p": 7,
   "c": 1,
   "ar": "وقال إن الرجل كان سببًا في الصلح بين صديقين تفرقا.",
   "en": "The visitor had brought peace between two estranged men, he said.",
   "a": 155.786,
   "b": 161.7
  },
  {
   "p": 7,
   "c": 2,
   "ar": "ثم زاده من ماله وخيله مثل ما ناله،",
   "en": "Yahya then matched the wealth and horses the man had received,",
   "a": 162.318,
   "b": 166.747
  },
  {
   "p": 7,
   "c": 3,
   "ar": "فخرج الفقير بغنيمتين بدل واحدة.",
   "en": "doubling his reward.",
   "a": 167.245,
   "b": 171.24
  }
 ],
